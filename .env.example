# Binance Square OpenAPI key, created at:
#   https://www.binance.com/square/creator-center/home
#
# This is NOT a trading API key. It only grants content publishing and
# cannot touch balances or place orders.
#
# Either export this variable, or save the key to disk once with:
#   wte auth save
BINANCE_SQUARE_OPENAPI_KEY=

# Where queue + history state lives. Defaults to ./.wte
# WTE_STATE_DIR=./.wte
