{
  "name": "writetoearn",
  "version": "0.1.0",
  "description": "Automated publishing tool for Binance Square via the Creator Center OpenAPI",
  "type": "module",
  "bin": {
    "wte": "./bin/wte.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node ./bin/wte.mjs",
    "doctor": "node ./bin/wte.mjs doctor",
    "check": "npm test && npm run doctor",
    "scan": "node ./scripts/scan-daily.mjs --print",
    "site": "node ./scripts/build-site.mjs"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
